include_guard(GLOBAL)

# Record the configured target dependency closure instead of every engine/tool DLL.
function(nexora_game_runtime_profile player)
  set(pending "${player}")
  set(visited)
  set(libraries)
  while(pending)
    list(POP_FRONT pending current)
    if(NOT TARGET "${current}")
      continue()
    endif()
    get_target_property(alias "${current}" ALIASED_TARGET)
    if(alias)
      set(current "${alias}")
    endif()
    if(current IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${current}")
    get_target_property(kind "${current}" TYPE)
    if(kind STREQUAL "SHARED_LIBRARY")
      list(APPEND libraries "${current}")
    endif()
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(dependencies "${current}" "${property}")
      if(dependencies)
        foreach(dependency IN LISTS dependencies)
          if(dependency MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
            set(dependency "${CMAKE_MATCH_1}")
          endif()
          if(TARGET "${dependency}")
            list(APPEND pending "${dependency}")
          endif()
        endforeach()
      endif()
    endforeach()
  endwhile()
  list(SORT libraries)
  set(profile "NEXORA_GAME_RUNTIME_1\nplayer=$<TARGET_FILE_NAME:${player}>\n")
  set(runtime_files)
  foreach(library IN LISTS libraries)
    string(APPEND profile "runtime=$<TARGET_FILE_NAME:${library}>\n")
    list(APPEND runtime_files "$<TARGET_FILE:${library}>")
  endforeach()
  if(MSVC)
    set(CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP TRUE)
    include(InstallRequiredSystemLibraries)
    foreach(runtime IN LISTS CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS)
      get_filename_component(filename "${runtime}" NAME)
      string(APPEND profile "runtime=${filename}\n")
      list(APPEND runtime_files "${runtime}")
      add_custom_command(TARGET "${player}" POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${runtime}" "$<TARGET_FILE_DIR:${player}>"
        VERBATIM)
    endforeach()
  endif()
  file(GENERATE OUTPUT "$<TARGET_FILE_DIR:${player}>/GameRuntime.profile" CONTENT "${profile}")
  set_property(TARGET "${player}" PROPERTY NEXORA_GAME_RUNTIME_TARGETS "${libraries}")
  set_property(TARGET "${player}" PROPERTY NEXORA_GAME_RUNTIME_FILES "${runtime_files}")
endfunction()
