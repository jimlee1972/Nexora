include_guard(GLOBAL)

function(nexora_declare_features)
  option(NEXORA_FEATURE_EXAMPLE_PLUGIN "Build the example optional plugin" ON)
  if(NEXORA_FEATURE_EXAMPLE_PLUGIN)
    add_subdirectory("${PROJECT_SOURCE_DIR}/Plugins/Example" "${PROJECT_BINARY_DIR}/Plugins/Example")
  endif()
  option(NEXORA_FEATURE_API_SAMPLES
         "Build the API-M1~M4 Engine API Foundation sample (Samples/Api)" ON)
  if(NEXORA_FEATURE_API_SAMPLES)
    add_subdirectory("${PROJECT_SOURCE_DIR}/Samples/Api" "${PROJECT_BINARY_DIR}/Samples/Api")
  endif()
  option(NEXORA_FEATURE_EDITOR_API_SAMPLES "Build the runnable Editor SDK samples" ${NEXORA_ENABLE_EDITOR})
  if(NOT NEXORA_ENABLE_EDITOR)
    if(NEXORA_FEATURE_EDITOR_API_SAMPLES)
      message(STATUS "Editor SDK samples unavailable: Editor is disabled")
    endif()
    set(NEXORA_FEATURE_EDITOR_API_SAMPLES OFF CACHE BOOL "Build the runnable Editor SDK samples" FORCE)
  endif()
  if(NEXORA_FEATURE_EDITOR_API_SAMPLES)
    add_subdirectory("${PROJECT_SOURCE_DIR}/Samples/Editor" "${PROJECT_BINARY_DIR}/Samples/Editor")
  endif()
endfunction()
