+         "independent sorted sprite X");
+    Near(frame->vertices[i * 4].position[1], -(expected[i].matrix[13] - 0.5) * 5 + 50,
+         "independent sorted sprite Y");
+  }
+  std::reverse(instances.begin(), instances.end());
