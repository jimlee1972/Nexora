cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED ROOT)
  message(FATAL_ERROR "ROOT is required")
endif()
if(NOT DEFINED MANIFEST)
  set(MANIFEST "${ROOT}/Config/Modules/modules.json")
endif()
file(READ "${MANIFEST}" graph)
string(JSON schema ERROR_VARIABLE json_error GET "${graph}" schema_version)
if(json_error OR NOT schema EQUAL 1)
  message(FATAL_ERROR "${MANIFEST}: unsupported or missing schema_version")
endif()
string(JSON module_count LENGTH "${graph}" modules)
if(module_count EQUAL 0)
  message(FATAL_ERROR "${MANIFEST}: modules cannot be empty")
endif()
math(EXPR last_module "${module_count} - 1")
set(names)
foreach(index RANGE ${last_module})
  string(JSON name GET "${graph}" modules ${index} name)
  if(name IN_LIST names)
    message(FATAL_ERROR "${MANIFEST}: duplicate module '${name}'")
  endif()
  list(APPEND names "${name}")
endforeach()

# Kahn's algorithm: repeatedly remove modules whose declared dependencies were removed.
set(remaining "${names}")
set(resolved)
while(remaining)
  set(progress FALSE)
  foreach(name IN LISTS remaining)
    list(FIND names "${name}" index)
    string(JSON dep_count LENGTH "${graph}" modules ${index} dependencies)
    set(ready TRUE)
    if(dep_count GREATER 0)
      math(EXPR last_dep "${dep_count} - 1")
      foreach(dep_index RANGE ${last_dep})
        string(JSON dep GET "${graph}" modules ${index} dependencies ${dep_index})
        if(NOT dep IN_LIST names)
          message(FATAL_ERROR "${MANIFEST}: '${name}' depends on unknown module '${dep}'")
        endif()
        if(NOT dep IN_LIST resolved)
          set(ready FALSE)
        endif()
      endforeach()
    endif()
    if(ready)
      list(APPEND resolved "${name}")
      list(REMOVE_ITEM remaining "${name}")
      set(progress TRUE)
    endif()
  endforeach()
  if(NOT progress)
    list(JOIN remaining ", " cycle_members)
    message(FATAL_ERROR "${MANIFEST}: dependency cycle involving ${cycle_members}")
  endif()
endwhile()
message(STATUS "Validated ${module_count} modules: no dependency cycles")
