cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED ROOT)
  message(FATAL_ERROR "ROOT is required")
endif()
file(GLOB manifests "${ROOT}/Plugins/*/plugin.json")
foreach(manifest IN LISTS manifests)
  file(READ "${manifest}" data)
  foreach(field schema_version id version engine_abi optional dependencies)
    string(JSON value ERROR_VARIABLE error GET "${data}" "${field}")
    if(error)
      message(FATAL_ERROR "${manifest}: missing or invalid '${field}'")
    endif()
  endforeach()
  string(JSON schema GET "${data}" schema_version)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "${manifest}: unsupported schema_version ${schema}")
  endif()
endforeach()
list(LENGTH manifests count)
message(STATUS "Validated ${count} plugin manifest(s)")
