# Keep verifier and preset provenance identical in Git and Windows packages.
Tools/Package/AcceptShowcaseWindows.ps1 text eol=lf
CMakePresets.json text eol=lf

# Pinned IBL provenance and converter hashes must survive Windows checkout.
Content/Showcase/Courtyard/Environment/* text eol=lf
Content/Showcase/Courtyard/Environment/*.hdr binary
Content/Showcase/Courtyard/Environment/*.rgba16f binary
Tools/Build/PrepareCourtyardEnvironment.py text eol=lf

# Original hero authoring, conversion and provenance are byte-stable across hosts.
Content/Showcase/Courtyard/Hero/* text eol=lf
Content/Showcase/Courtyard/Hero/*.rgba binary
Tools/Build/PrepareCourtyardHero.py text eol=lf
Apps/Showcase/CourtyardHero.h text eol=lf
LICENSE text eol=lf
